server {
    # Listen
    listen 127.0.0.1:${GATEWAY_EXPOSE_PORT};

    # Server name
    server_name ${ADMIN_FRONTEND_SERVER_NAME};

    # Locations
    include /etc/nginx/snippets/files.conf;

    location /api {
        include /etc/nginx/snippets/proxy.conf;
        include /etc/nginx/snippets/websocket.conf;
        proxy_pass http://127.0.0.1:${MANAGEMENT_BACKEND_PORT};
    }

    # Nuxt dev server, including the Vite HMR websocket.
    location / {
        include /etc/nginx/snippets/proxy.conf;
        include /etc/nginx/snippets/websocket.conf;
        proxy_pass http://127.0.0.1:${ADMIN_FRONTEND_PORT};
    }
}
