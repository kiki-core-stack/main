# Dev settings of this repo (dev-gateway.sh, update-pack-sha.mjs); copy to .env.development.local.

# Base
PROJECT_NAME='kiki-core-stack'

# Gateway

## Port on 127.0.0.1 for the host proxy to forward to; give each KCS checkout on the same machine its own.
GATEWAY_EXPOSE_PORT=10000

# Files

## Must match FILE_STORAGE_LOCAL_BASE_PATH of the dev servers.
FILE_STORAGE_LOCAL_BASE_PATH="/data/projects/${PROJECT_NAME}/development/files"

# Pack

## Git ref update-pack-sha.mjs pins repos/* to: HEAD, a branch or tag name, or a full commit SHA.
PACK_GIT_REF='HEAD'

# Service-specific configuration

## Ports must match the dev servers' own env (each repo's .env.development.local).

## Admin frontend
ADMIN_FRONTEND_PORT=10003
ADMIN_FRONTEND_SERVER_NAME=''

## Management backend
MANAGEMENT_BACKEND_PORT=10002
