# Base
ENVIRONMENT='production'
PROJECT_NAME='kiki-core-stack'

# Compose
DOCKER_REGISTRY_HOST=''
FILE_STORAGE_LOCAL_BASE_PATH="/data/projects/${PROJECT_NAME}/${ENVIRONMENT}/files"
LOGS_ROOT_PATH="/data/projects/${PROJECT_NAME}/${ENVIRONMENT}/logs"
NPM_CONFIG_REGISTRY='https://registry.npmjs.org'
PNPM_CONFIG_REGISTRY='https://registry.npmjs.org'

## For secrets

### Database
MONGODB_RS_HOST='mongodb'
MONGODB_URI="mongodb://${MONGODB_RS_HOST}:27017/${PROJECT_NAME}-${ENVIRONMENT}?directConnection=true&replicaSet=rs0"

### Keys

#### Secrets of at least 32 bytes (no commas) encrypting stored secrets such as TOTP seeds, comma-separated for rotation
#### (the first encrypts). Generate: openssl rand -base64 32
AUTH_SECRET_ENCRYPTION_KEYS=''

### Redis
REDIS_URL='redis://dragonfly:6379'

# Service-specific configuration

## Admin frontend
ADMIN_FRONTEND_SERVER_NAME=''

## Gateway
GATEWAY_EXPOSE_PORT=10000
