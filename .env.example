# Base
ENVIRONMENT='production'
PROJECT_NAME='kiki-core-stack'

# Compose
DOCKER_REGISTRY_HOST=''
LOGS_ROOT_PATH="/data/projects/${PROJECT_NAME}/${ENVIRONMENT}/logs"
NPM_CONFIG_REGISTRY='https://registry.npmjs.org'
PNPM_CONFIG_REGISTRY='https://registry.npmjs.org'

## For secrets

### Database
MONGODB_RS_HOST='mongodb'
MONGODB_URI="mongodb://${MONGODB_RS_HOST}:27017/${PROJECT_NAME}-${ENVIRONMENT}?directConnection=true&replicaSet=rs0"

### File storage

#### S3-compatible storage holding the buckets <PROJECT_NAME>-<ENVIRONMENT>-public and -private (e.g. the RustFS of
#### infra-services). The gateway serves the public bucket at /files/, so the endpoint must be reachable from it too.
FILE_STORAGE_S3_ENDPOINT='http://rustfs:9000'
#### Empty uses us-east-1; R2 uses 'auto'.
FILE_STORAGE_S3_REGION=''
FILE_STORAGE_S3_ACCESS_KEY_ID=''
FILE_STORAGE_S3_SECRET_ACCESS_KEY=''

### Keys

#### Secrets of at least 32 bytes (no commas) encrypting stored secrets such as TOTP seeds, comma-separated for rotation
#### (the first encrypts). Generate: openssl rand -base64 32
AUTH_SECRET_ENCRYPTION_KEYS=''

### Redis
REDIS_URL='redis://dragonfly:6379'

# Service-specific configuration

## Admin frontend

### Domain only (e.g. admin.example.com); `https://<domain>` is the origin of the services that authenticate admins.
ADMIN_FRONTEND_SERVER_NAME=''

## Gateway
GATEWAY_EXPOSE_PORT=10000

## Management backend
MANAGEMENT_BACKEND_WS_IO_AUTH_KEY=''
MANAGEMENT_BACKEND_WS_IO_INTROSPECTION_TOKEN='' # must contain at least 32 bytes
