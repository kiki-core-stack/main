# Base
ENVIRONMENT='production'
PROJECT_NAME='kiki-core-stack'

# Compose
DOCKER_REGISTRY_HOST=''
LOGS_ROOT_PATH="/data/projects/${PROJECT_NAME}/${ENVIRONMENT}/logs"
NPM_CONFIG_REGISTRY='https://registry.npmjs.org'
PNPM_CONFIG_REGISTRY='https://registry.npmjs.org'

# Domains

## Domain only, without the scheme.
ADMIN_FRONTEND_SERVER_NAME=''

# Gateway

## Unique per project and environment on the same machine.
GATEWAY_EXPOSE_PORT=10000

# Database and Redis
MONGODB_URI="mongodb://mongodb:27017/${PROJECT_NAME}-${ENVIRONMENT}?directConnection=true&replicaSet=rs0"
REDIS_URL='redis://dragonfly:6379'

# File storage
FILE_STORAGE_S3_ENDPOINT='http://rustfs:9000'

## us-east-1 for RustFS / MinIO; 'auto' for R2.
FILE_STORAGE_S3_REGION='us-east-1'
FILE_STORAGE_S3_ACCESS_KEY_ID="${PROJECT_NAME}-${ENVIRONMENT}"
FILE_STORAGE_S3_SECRET_ACCESS_KEY=''

# Keys

## scripts/profile.mjs check replaces '{{ AUTO_GENERATE }}' with a random value once. *_KEYS rotate comma-separated (the first encrypts).
AUTH_SECRET_ENCRYPTION_KEYS='{{ AUTO_GENERATE }}'
MANAGEMENT_BACKEND_COOKIE_SESSION_KEYS='{{ AUTO_GENERATE }}'
MANAGEMENT_BACKEND_WS_IO_AUTH_KEY='{{ AUTO_GENERATE }}'
MANAGEMENT_BACKEND_WS_IO_INTROSPECTION_TOKEN='{{ AUTO_GENERATE }}'

# Tuning
EMAIL_SEND_JOB_WORKER_CONCURRENCY=4
MANAGEMENT_BACKEND_SERVER_WORKERS=4
SMS_SEND_JOB_WORKER_CONCURRENCY=4
