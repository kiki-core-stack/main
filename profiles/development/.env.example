# Keys only the production stack uses are required too: compose resolves the whole stack.

# Base
ENVIRONMENT='development'
PROJECT_NAME='kiki-core-stack'

# Compose
DOCKER_REGISTRY_HOST=''
LOGS_ROOT_PATH="/data/projects/${PROJECT_NAME}/${ENVIRONMENT}/logs"
NPM_CONFIG_REGISTRY='https://registry.npmjs.org'
PNPM_CONFIG_REGISTRY='https://registry.npmjs.org'

# Pack

## HEAD, a branch, a tag or a full commit SHA.
PACK_GIT_REF='HEAD'

# Domains

## Domain only, without the scheme.
ADMIN_FRONTEND_SERVER_NAME=''

# Gateway
GATEWAY_EXPOSE_HOST='127.0.0.1'

## This and the dev server ports: unique per project and environment on the same machine.
GATEWAY_EXPOSE_PORT=10000

# Dev servers
ADMIN_FRONTEND_PORT=10003
MANAGEMENT_BACKEND_PORT=10002
WS_IO_SERVER_PORT=10001
VALIDATE_RESPONSES=false

# Database and Redis
MONGODB_URI="mongodb://127.0.0.1:27017/${PROJECT_NAME}-${ENVIRONMENT}?directConnection=true&replicaSet=rs0"
REDIS_URL='redis://127.0.0.1:6379'

# File storage
FILE_STORAGE_S3_ENDPOINT=''

## us-east-1 for RustFS / MinIO; 'auto' for R2.
FILE_STORAGE_S3_REGION='us-east-1'
FILE_STORAGE_S3_ACCESS_KEY_ID="${PROJECT_NAME}-${ENVIRONMENT}"
FILE_STORAGE_S3_SECRET_ACCESS_KEY=''

# Keys

## Secrets of at least 32 bytes (no commas), comma-separated for rotation (the first encrypts).
## Generate: openssl rand -base64 32
AUTH_SECRET_ENCRYPTION_KEYS=''
MANAGEMENT_BACKEND_COOKIE_SESSION_KEYS=''

## The introspection token must contain at least 32 bytes.
MANAGEMENT_BACKEND_WS_IO_AUTH_KEY=''
MANAGEMENT_BACKEND_WS_IO_INTROSPECTION_TOKEN=''

# Tuning
EMAIL_SEND_JOB_WORKER_CONCURRENCY=4
MANAGEMENT_BACKEND_SERVER_WORKERS=1
SMS_SEND_JOB_WORKER_CONCURRENCY=4
